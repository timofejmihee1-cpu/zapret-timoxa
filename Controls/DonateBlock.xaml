<UserControl x:Class="Zapret2UI.Controls.DonateBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Zapret2UI.Localization"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf">
    <!-- Non-collapsible RAM Usage widget for zapret_timosha and winws2 engine -->
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14,12"
            Width="220"
            SnapsToDevicePixels="True">
        <StackPanel>
            <!-- Header: live status dot + label + total RAM -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="{StaticResource AccentBrush}"
                            Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ПАМЯТЬ / RAM"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource FgMutedBrush}"
                               FontFamily="{StaticResource DisplayFont}"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding TotalRamText, FallbackValue='0 МБ'}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource FgBrush}"
                           FontFamily="{StaticResource MonoFont}"/>
            </Grid>

            <!-- Visual indicator bar -->
            <Border Background="{StaticResource SurfaceAltBrush}" Height="5" CornerRadius="2.5" Margin="0,0,0,10">
                <Border HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}"
                        Height="5"
                        CornerRadius="2.5"
                        Width="{Binding RamPercent, FallbackValue=25}"/>
            </Border>

            <!-- Memory breakdown: zapret_timosha (app) and winws2 (engine) -->
            <Grid Margin="0,0,0,5">
                <TextBlock Text="zapret_timosha"
                           FontSize="11.5"
                           Foreground="{StaticResource FgMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding AppRamText, FallbackValue='0 МБ'}"
                           HorizontalAlignment="Right"
                           FontSize="11.5"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource FgBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid>
                <TextBlock Text="winws2 (движок)"
                           FontSize="11.5"
                           Foreground="{StaticResource FgMutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding EngineRamText, FallbackValue='0 МБ'}"
                           HorizontalAlignment="Right"
                           FontSize="11.5"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource FgBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Game mode badge -->
            <Border Visibility="{Binding IsGameModeActive, Converter={StaticResource BoolToVis}}"
                    Background="#22FFFFFF" CornerRadius="8" Padding="6,4" Margin="0,9,0,0">
                <TextBlock Text="⚡ Оптимизация для игр" FontSize="11" Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
